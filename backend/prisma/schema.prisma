datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum AccountType {
  PARENT
  BUSINESS
  ADMIN
}

enum UserRole {
  FAMILY_PARENT
  ORGANIZATION_ADMIN
  ORGANIZATION_MANAGER
  SUPER_ADMIN
  SUPPORT_AGENT
  BILLING_MANAGER
}

enum CollectionMethod {
  android_api
  notification
  accessibility
  media
  device_policy
  user_action
  broadcast_receiver
}

enum AudioCaptureMode {
  two_way_hardware
  mic_fallback
  surround_only
  unsupported
}

enum LicenseStatus {
  UNASSIGNED
  ACTIVE
  EXPIRED
  REVOKED
}

model User {
  id             String        @id @default(uuid())
  email          String        @unique
  passwordHash   String
  name           String
  pairingCode    String?       @unique
  accountType    AccountType
  roles          UserRole[]
  familyId       String?
  family         Family?       @relation(fields: [familyId], references: [id])
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  licenses       License[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  auditLogs      AuditLog[]

  @@index([familyId])
  @@index([organizationId])
  @@index([pairingCode])
}

model License {
  id               String        @id @default(uuid())
  licenseKey       String        @unique
  planName         String        // e.g. "ChildCare All-in-One Pro 1-Year", "Family 3-Device Plan"
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedDeviceId String?       @unique
  assignedDevice   Device?       @relation(fields: [assignedDeviceId], references: [id], onDelete: SetNull)
  status           LicenseStatus @default(UNASSIGNED)
  expiresAt        DateTime
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([userId])
  @@index([licenseKey])
}

model Family {
  id        String   @id @default(uuid())
  name      String
  members   User[]
  devices   Device[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  members   User[]
  devices   Device[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Device {
  id             String             @id @default(uuid())
  name           String
  pairingCode    String?
  isPaired       Boolean            @default(false)
  androidVersion Int
  sdkInt         Int
  manufacturer   String
  model          String
  familyId       String?
  family         Family?            @relation(fields: [familyId], references: [id])
  organizationId String?
  organization   Organization?      @relation(fields: [organizationId], references: [id])
  license        License?
  capabilities   CapabilityMatrix?
  events         NormalizedEvent[]
  callLogs       CallLog[]
  smsLogs        SmsLog[]
  locations      LocationLog[]
  contacts       Contact[]
  keylogs        Keylog[]
  installedApps  InstalledApp[]
  webHistory     WebHistory[]
  calendarEvents CalendarEvent[]
  mediaAssets    MediaAsset[]
  appUsage       AppUsage[]
  whatsappMessages WhatsAppMessage[]
  appRules       AppRestriction[]
  webRules       WebFilterRule[]
  callRules      CallRestriction[]
  geofences      GeofenceRule[]
  updateJobs     DeviceUpdateJob[]
  lastSeenAt     DateTime           @default(now())
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([familyId])
  @@index([organizationId])
}

model CapabilityMatrix {
  id                    String           @id @default(uuid())
  deviceId              String           @unique
  device                Device           @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  location              Boolean          @default(true)
  callLogs              Boolean          @default(true)
  sms                   Boolean          @default(true)
  contacts              Boolean          @default(true)
  appUsage              Boolean          @default(true)
  keylogger             Boolean          @default(false)
  screenshots           Boolean          @default(false)
  audioCaptureMode      AudioCaptureMode @default(surround_only)
  whatsappNotifications Boolean          @default(true)
  whatsappAccessibility Boolean          @default(false)
  whatsappMedia         Boolean          @default(true)
  deviceOwnerMode       Boolean          @default(false)
  updatedAt             DateTime         @updatedAt
}

model NormalizedEvent {
  id               String           @id @default(uuid())
  eventId          String           @unique
  deviceId         String
  device           Device           @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  source           String
  eventType        String
  timestamp        DateTime
  collectionMethod CollectionMethod
  payload          Json
  createdAt        DateTime         @default(now())

  @@index([deviceId, timestamp])
  @@index([source])
}

model CallLog {
  id          String   @id @default(uuid())
  deviceId    String
  device      Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  phoneNumber String
  contactName String?
  direction   String   // INCOMING, OUTGOING, MISSED
  durationSec Int
  timestamp   DateTime
  recordingId String?
  createdAt   DateTime @default(now())

  @@index([deviceId, timestamp])
}

model SmsLog {
  id          String   @id @default(uuid())
  deviceId    String
  device      Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  phoneNumber String
  contactName String?
  body        String
  direction   String   // INCOMING, OUTGOING
  timestamp   DateTime
  createdAt   DateTime @default(now())

  @@index([deviceId, timestamp])
}

model LocationLog {
  id        String   @id @default(uuid())
  deviceId  String
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  latitude  Float
  longitude Float
  accuracy  Float
  speed     Float?
  timestamp DateTime
  createdAt DateTime @default(now())

  @@index([deviceId, timestamp])
}

model Contact {
  id          String   @id @default(uuid())
  deviceId    String
  device      Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  contactName String
  phoneNumber String
  email       String?
  timestamp   DateTime @default(now())
  createdAt   DateTime @default(now())

  @@unique([deviceId, phoneNumber])
  @@index([deviceId, timestamp])
}

model Keylog {
  id          String   @id @default(uuid())
  deviceId    String
  device      Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  packageName String
  appName     String
  typedText   String
  timestamp   DateTime
  createdAt   DateTime @default(now())

  @@index([deviceId, timestamp])
  @@index([deviceId, packageName])
}

model InstalledApp {
  id          String   @id @default(uuid())
  deviceId    String
  device      Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  packageName String
  appName     String
  versionName String?
  versionCode Int?
  isSystemApp Boolean  @default(false)
  isBlocked   Boolean  @default(false)
  status      String   @default("Installed")
  timestamp   DateTime @default(now())
  createdAt   DateTime @default(now())

  @@unique([deviceId, packageName])
  @@index([deviceId, timestamp])
}

model WebHistory {
  id          String   @id @default(uuid())
  deviceId    String
  device      Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  title       String
  url         String
  domain      String
  visitCount  Int      @default(1)
  isBlocked   Boolean  @default(false)
  timestamp   DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([deviceId, timestamp])
  @@index([deviceId, domain])
}

model CalendarEvent {
  id          String   @id @default(uuid())
  deviceId    String
  device      Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  title       String
  location    String?
  startDate   DateTime
  endDate     DateTime?
  description String?
  category    String   @default("Personal")
  timestamp   DateTime @default(now())
  createdAt   DateTime @default(now())

  @@unique([deviceId, title])
  @@index([deviceId, timestamp])
}

model MediaAsset {
  id          String   @id @default(uuid())
  deviceId    String
  device      Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  category    String   // PHOTO, SCREENSHOT, VOICE_NOTE, CALL_RECORDING, SURROUND
  storageKey  String
  fileHash    String
  fileSizeBytes Int
  mimeType    String
  timestamp   DateTime
  createdAt   DateTime @default(now())

  @@index([deviceId, category])
}

model AppUsage {
  id                    String   @id @default(uuid())
  deviceId              String
  device                Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  packageName           String
  appName               String
  date                  String   // e.g. "2026-09-04" for day-wise aggregation
  hour                  Int      // 0 to 23 for hour-wise filtering
  totalTimeForegroundMs BigInt   @default(0)
  lastTimeUsed          DateTime
  timestamp             DateTime @default(now())
  createdAt             DateTime @default(now())

  @@unique([deviceId, packageName, date, hour])
  @@index([deviceId, date])
  @@index([deviceId, packageName])
}

model AppRestriction {
  id                    String   @id @default(uuid())
  deviceId              String
  device                Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  packageName           String
  appName               String
  isBlocked             Boolean  @default(false)
  dailyTimeLimitMinutes Int?
  updatedAt             DateTime @updatedAt

  @@unique([deviceId, packageName])
}

model CallRestriction {
  id          String   @id @default(uuid())
  deviceId    String
  device      Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  phoneNumber String
  contactName String?
  isBlocked   Boolean  @default(true)
  updatedAt   DateTime @updatedAt

  @@unique([deviceId, phoneNumber])
}

model WebFilterRule {
  id          String   @id @default(uuid())
  deviceId    String
  device      Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  domainOrUrl String
  category    String?
  action      String   // ALLOW, BLOCK
  updatedAt   DateTime @updatedAt

  @@unique([deviceId, domainOrUrl])
}

model GeofenceRule {
  id           String   @id @default(uuid())
  deviceId     String
  device       Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  name         String
  latitude     Float
  longitude    Float
  radiusMeters Float
  alertOnEntry Boolean  @default(true)
  alertOnExit  Boolean  @default(true)
  updatedAt    DateTime @updatedAt
}

model AppRelease {
  id           String            @id @default(uuid())
  versionCode  Int               @unique
  versionName  String
  apkUrl       String
  sha256       String
  isMandatory  Boolean           @default(false)
  releaseNotes String
  createdAt    DateTime          @default(now())
  updateJobs   DeviceUpdateJob[]
}

model DeviceUpdateJob {
  id           String     @id @default(uuid())
  deviceId     String
  device       Device     @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  releaseId    String
  release      AppRelease @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  status       String     // PENDING, DOWNLOADING, INSTALLING, COMPLETED, FAILED
  progress     Int        @default(0)
  errorMessage String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([deviceId])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  resource  String
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model WhatsAppMessage {
  id               String   @id @default(uuid())
  deviceId         String
  device           Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  chatTitle        String
  sender           String
  message          String
  isOutgoing       Boolean  @default(false)
  appName          String   @default("WhatsApp")
  collectionMethod String   @default("accessibility")
  timestamp        DateTime
  createdAt        DateTime @default(now())

  @@index([deviceId, chatTitle, timestamp])
  @@index([deviceId, timestamp])
}
