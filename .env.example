# Environment Mode
NODE_ENV=development
PORT=3000

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://parental_admin:parental_secret_password@localhost:5432/parental_monitoring?schema=public"

# Redis Cache & BullMQ Queue
REDIS_HOST=localhost
REDIS_PORT=6379

# Object Storage (Cloudflare R2 / Local MinIO)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minio_admin
STORAGE_SECRET_KEY=minio_password
STORAGE_BUCKET=parental-media-bucket
STORAGE_REGION=auto

# Security & JWT Secrets
JWT_SECRET=super_secret_jwt_access_key_change_me_in_production
JWT_EXPIRATION=1d
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_change_me_in_production
JWT_REFRESH_EXPIRATION=30d

# Firebase Cloud Messaging (FCM) Push Messaging
FCM_PROJECT_ID=parental-monitoring-fcm
FCM_CLIENT_EMAIL=firebase-adminsdk@parental-monitoring.iam.gserviceaccount.com
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Web Applications Base URLs
CLIENT_DASHBOARD_URL=http://localhost:5173
ADMIN_DASHBOARD_URL=http://localhost:5174
